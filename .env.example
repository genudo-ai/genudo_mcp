# Genudo MCP Client Configuration

# Your Genudo Token (REQUIRED)
# Get this from your Genudo account settings — a Bearer token with the mcp:access scope
GENUDO_TOKEN=your_token_here

# Base URL (OPTIONAL - defaults to https://api.genudo.ai)
# For self-hosted instances or local development
# GENUDO_BASE_URL=https://your-instance.com

# Allow insecure SSL (OPTIONAL - defaults to false)
# Only use for local development with self-signed certificates
# GENUDO_ALLOW_INSECURE_SSL=true

# Working directory (OPTIONAL - defaults to the current directory)
# Where the agent writes local pipeline mirrors, version snapshots and cached guides.
# Set it to keep all client work in one stable folder.
# GENUDO_WORKDIR=/Users/you/genudo
